diff --git a/cmake/FindBZip2.cmake b/cmake/FindBZip2.cmake
new file mode 100644
--- /dev/null	(revision d6d72c146317afe0d532173a41e995b52e1fa743)
+++ b/cmake/FindBZip2.cmake	(revision d6d72c146317afe0d532173a41e995b52e1fa743)
@@ -0,0 +1,55 @@
+# Configure sisong's bzip2 fork. There is also a conan recipe in https://conan.io/center/recipes/bzip2, and a spiritual
+# successor of that library in https://conan.io/center/recipes/bzip3. Sisong made some changes to the original code of
+# bzip2, so we would need to apply those patches if we were to use it (hard to tell how much he/she changed).
+
+include(FetchContent)
+include(GNUInstallDirs)
+
+# Configuration — you can override the repo or commit via cache vars
+set(BZIP2_GIT_REPOSITORY "https://github.com/Seclous/bzip2.git"
+        CACHE STRING "Git repository for BZip2")
+set(BZIP2_GIT_TAG "fbc4b11da543753b3b803e5546f56e26ec90c2a7"
+        CACHE STRING "Git commit or tag for BZip2")
+
+message(STATUS "Fetching BZip2 from ${BZIP2_GIT_REPOSITORY} at ${BZIP2_GIT_TAG}")
+
+FetchContent_Declare(
+        bzip2
+        GIT_REPOSITORY ${BZIP2_GIT_REPOSITORY}
+        GIT_TAG ${BZIP2_GIT_TAG}
+)
+
+FetchContent_MakeAvailable(bzip2)
+
+if (NOT TARGET BZip2::BZip2)
+    # Manually define the target, since the fetched project has no CMakeLists.txt
+    set(bzip2_SOURCE_DIR "${bzip2_SOURCE_DIR}" CACHE INTERNAL "")
+    file(GLOB BZIP2_SOURCES
+            "${bzip2_SOURCE_DIR}/blocksort.c"
+            "${bzip2_SOURCE_DIR}/bzlib.c"
+            "${bzip2_SOURCE_DIR}/compress.c"
+            "${bzip2_SOURCE_DIR}/crctable.c"
+            "${bzip2_SOURCE_DIR}/decompress.c"
+            "${bzip2_SOURCE_DIR}/huffman.c"
+            "${bzip2_SOURCE_DIR}/randtable.c"
+    )
+
+    if (NOT BZIP2_SOURCES)
+        message(FATAL_ERROR "Failed to locate BZip2 sources in ${bzip2_SOURCE_DIR}")
+    endif ()
+
+    add_library(BZip2 STATIC ${BZIP2_SOURCES})
+    add_library(BZip2::BZip2 ALIAS BZip2)
+    target_include_directories(BZip2
+            PUBLIC
+            $<BUILD_INTERFACE:${bzip2_SOURCE_DIR}>
+            $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/bzip2>
+    )
+    target_compile_definitions(BZip2 PRIVATE _FILE_OFFSET_BITS=64)
+
+    if (MSVC)
+        set_target_properties(BZip2 PROPERTIES
+                MSVC_RUNTIME_LIBRARY "${CMAKE_MSVC_RUNTIME_LIBRARY}"
+        )
+    endif ()
+endif ()
