+        classic_locale (std::basic_ios<C>& ios)
+        {
+          ios.imbue (std::locale::classic ());
+        }
+
+        template <typename C>
+        class scoped_stream_locale
+        {
+        public:
+          explicit
+          scoped_stream_locale (std::basic_ios<C>& ios)
+              : ios_ (ios), locale_ (ios.getloc ())
+          {
+            ios_.imbue (std::locale::classic ());
+          }
+
+          ~scoped_stream_locale ()
+          {
+            ios_.imbue (locale_);
+          }
+
+        private:
+          scoped_stream_locale (const scoped_stream_locale&);
+          scoped_stream_locale& operator= (const scoped_stream_locale&);
+
+        private:
+          std::basic_ios<C>& ios_;
+          std::locale locale_;
+        };
+      }
