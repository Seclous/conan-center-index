diff --git a/cmake/FindxxHash.cmake b/cmake/FindxxHash.cmake
new file mode 100644
--- /dev/null	(revision d6d72c146317afe0d532173a41e995b52e1fa743)
+++ b/cmake/FindxxHash.cmake	(revision d6d72c146317afe0d532173a41e995b52e1fa743)
@@ -0,0 +1,38 @@
+# Configure xxHash. We are using the release branch on a specific commit. There is also a conan recipe of this code
+# in https://conan.io/center/recipes/xxhash. See if we can eventually migrate to this (i.e., depends on the changes with
+# respect to the latest version in conan center).
+
+include(FetchContent)
+include(GNUInstallDirs)
+
+set(XXHASH_GIT_REPOSITORY "https://github.com/Cyan4973/xxHash.git"
+        CACHE STRING "Git repository for xxHash")
+set(XXHASH_GIT_TAG "e626a72bc2321cd320e953a0ccf1584cad60f363"
+        CACHE STRING "Git tag or commit for xxHash")
+
+message(STATUS "Fetching xxHash from ${XXHASH_GIT_REPOSITORY} at ${XXHASH_GIT_TAG}")
+
+# Tell the unofficial cmake to skip unneeded builds
+set(XXHASH_BUILD_XXHSUM OFF CACHE BOOL "Disable building xxhsum CLI" FORCE)
+set(XXHASH_BUILD_ENABLE_INLINE_API OFF CACHE BOOL "Disable inline xxHash API" FORCE)
+set(BUILD_SHARED_LIBS OFF CACHE BOOL "Build static library" FORCE)
+set(DISPATCH OFF CACHE BOOL "Disable dispatch mode" FORCE)
+
+FetchContent_Declare(
+        xxhash
+        GIT_REPOSITORY ${XXHASH_GIT_REPOSITORY}
+        GIT_TAG ${XXHASH_GIT_TAG}
+)
+
+FetchContent_MakeAvailable(xxhash)
+
+# The source dir will now exist, but xxHash has no root-level CMakeLists.txt.
+# We need to manually add the cmake_unofficial subproject if it hasn't already been added.
+if (NOT TARGET xxhash AND EXISTS "${xxhash_SOURCE_DIR}/cmake_unofficial/CMakeLists.txt")
+    add_subdirectory("${xxhash_SOURCE_DIR}/cmake_unofficial" "${xxhash_BINARY_DIR}" EXCLUDE_FROM_ALL)
+endif ()
+
+# Create a canonical alias for downstream use
+if (TARGET xxhash AND NOT TARGET xxHash::xxhash)
+    add_library(xxHash::xxhash ALIAS xxhash)
+endif ()
