+# Configure sisong's zstd fork. There is also a conan recipe in https://conan.io/center/recipes/zstd, but sisong
+# made some changes to the original code, so we would have to apply patches if we were to use it (not too many changes
+# by the author).
+
+include(FetchContent)
+include(GNUInstallDirs)
+
+set(ZSTD_GIT_REPOSITORY "https://github.com/Seclous/zstd.git"
+        CACHE STRING "Git repository for zstd")
+set(ZSTD_GIT_TAG "68c88c7c7ad22b5e6882a5296ef96d27dc8750c4"
+        CACHE STRING "Git commit or tag for zstd")
+
+message(STATUS "Fetching Zstd from ${ZSTD_GIT_REPOSITORY} at ${ZSTD_GIT_TAG}")
+
+FetchContent_Declare(
+        zstd
+        GIT_REPOSITORY ${ZSTD_GIT_REPOSITORY}
+        GIT_TAG ${ZSTD_GIT_TAG}
+)
+
+FetchContent_MakeAvailable(zstd)
+
+if (NOT TARGET zstd::libzstd_static AND NOT TARGET zstd::libzstd_shared AND NOT TARGET zstd::zstd AND NOT TARGET Zstd::Zstd)
+    set(ZSTD_LIB_ROOT "${zstd_SOURCE_DIR}/lib")
+    set(ZSTD_COMMON_DIR "${ZSTD_LIB_ROOT}/common")
+    set(ZSTD_COMPRESS_DIR "${ZSTD_LIB_ROOT}/compress")
+    set(ZSTD_DECOMPRESS_DIR "${ZSTD_LIB_ROOT}/decompress")
+
+    # ---------------- Base sources (common + decompress) ----------------
+    set(ZSTD_SOURCES
+            "${ZSTD_COMMON_DIR}/debug.c"
+            "${ZSTD_COMMON_DIR}/entropy_common.c"
+            "${ZSTD_COMMON_DIR}/error_private.c"
+            "${ZSTD_COMMON_DIR}/fse_decompress.c"
+            "${ZSTD_COMMON_DIR}/xxhash.c"
+            "${ZSTD_COMMON_DIR}/zstd_common.c"
+
+            "${ZSTD_DECOMPRESS_DIR}/huf_decompress.c"
+            "${ZSTD_DECOMPRESS_DIR}/zstd_ddict.c"
+            "${ZSTD_DECOMPRESS_DIR}/zstd_decompress.c"
+            "${ZSTD_DECOMPRESS_DIR}/zstd_decompress_block.c"
+
+            "${ZSTD_COMPRESS_DIR}/fse_compress.c"
+            "${ZSTD_COMPRESS_DIR}/hist.c"
+            "${ZSTD_COMPRESS_DIR}/huf_compress.c"
+            "${ZSTD_COMPRESS_DIR}/zstd_compress.c"
+            "${ZSTD_COMPRESS_DIR}/zstd_compress_literals.c"
+            "${ZSTD_COMPRESS_DIR}/zstd_compress_sequences.c"
+            "${ZSTD_COMPRESS_DIR}/zstd_compress_superblock.c"
+            "${ZSTD_COMPRESS_DIR}/zstd_preSplit.c"
+            "${ZSTD_COMPRESS_DIR}/zstd_double_fast.c"
+            "${ZSTD_COMPRESS_DIR}/zstd_fast.c"
+            "${ZSTD_COMPRESS_DIR}/zstd_lazy.c"
+            "${ZSTD_COMPRESS_DIR}/zstd_ldm.c"
+            "${ZSTD_COMPRESS_DIR}/zstd_opt.c"
+    )
+
+    # ---------------- Multithread support ----------------
+    if (DEFINED HDIFFPATCH_ENABLE_MULTITHREAD AND HDIFFPATCH_ENABLE_MULTITHREAD)
+        list(APPEND ZSTD_SOURCES
+                "${ZSTD_COMMON_DIR}/pool.c"
+                "${ZSTD_COMMON_DIR}/threading.c"
+                "${ZSTD_COMPRESS_DIR}/zstdmt_compress.c"
+        )
+    endif ()
+
+    # ---------------- Create Static Target ----------------
+    add_library(zstd_static STATIC ${ZSTD_SOURCES})
+    add_library(zstd::libzstd_static ALIAS zstd_static)
+
+    target_include_directories(zstd_static
+            PUBLIC
+            $<BUILD_INTERFACE:${ZSTD_LIB_ROOT}>
+            $<BUILD_INTERFACE:${ZSTD_COMMON_DIR}>
+            $<BUILD_INTERFACE:${ZSTD_COMPRESS_DIR}>
+            $<BUILD_INTERFACE:${ZSTD_DECOMPRESS_DIR}>
+            $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/zstd>
+    )
+
+    target_compile_definitions(zstd_static PRIVATE
+            ZSTD_HAVE_WEAK_SYMBOLS=0
+            ZSTD_TRACE=0
+            ZSTD_DISABLE_ASM=1
+            ZSTDLIB_HIDDEN=
+            ZSTDLIB_VISIBLE=
+            ZDICTLIB_VISIBLE=
+            ZSTDERRORLIB_VISIBLE=
+            ZSTD_LIB_DEPRECATED=0
+            ZSTD_STRIP_ERROR_STRINGS=1
+    )
+
+    # Set symbol visibility off for a smaller library.
+    target_compile_options(zstd_static PRIVATE -fvisibility=hidden)
+
+    if (MSVC)
+        set_target_properties(zstd_static PROPERTIES
+                MSVC_RUNTIME_LIBRARY "${CMAKE_MSVC_RUNTIME_LIBRARY}"
+        )
+    endif ()
+
+endif ()
