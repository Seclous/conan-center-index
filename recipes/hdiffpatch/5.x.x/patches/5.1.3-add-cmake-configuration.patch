diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
--- /dev/null	(revision d6d72c146317afe0d532173a41e995b52e1fa743)
+++ b/CMakeLists.txt	(revision d6d72c146317afe0d532173a41e995b52e1fa743)
@@ -0,0 +1,374 @@
+cmake_minimum_required(VERSION 3.24)
+
+project(HDiffPatch LANGUAGES C CXX VERSION 5.1.3)
+
+list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
+
+if (NOT CMAKE_BUILD_TYPE)
+    set(CMAKE_BUILD_TYPE Release)
+endif ()
+
+include(CheckIPOSupported)
+
+# This CMake file intentionally mirrors some of the upstream Makefile defaults
+
+set(HDIFFPATCH_ROOT "${CMAKE_CURRENT_LIST_DIR}" CACHE PATH "Path to the HDiffPatch source tree")
+
+option(HDIFFPATCH_BUILD_TOOLS "Build hdiffz and hpatchz command line tools" ON)
+option(HDIFFPATCH_BUILD_TESTS "Build upstream unit_test target" OFF)
+option(HDIFFPATCH_ENABLE_DIR_DIFF "Enable directory diff/patch support" ON)
+option(HDIFFPATCH_ENABLE_MULTITHREAD "Enable multithread support" ON)
+option(HDIFFPATCH_ENABLE_VCDIFF "Enable VCDIFF compatibility support" ON)
+option(HDIFFPATCH_ENABLE_BSDIFF "Enable bsdiff/bspatch compatibility support" ON)
+option(HDIFFPATCH_ENABLE_MD5 "Enable md5 checksum plugin for directory diff" OFF) # Default ON Makefile
+option(HDIFFPATCH_ENABLE_XXHASH "Enable xxh3 and xxh128 checksum plugins for directory diff" OFF) # Default ON Makefile
+option(HDIFFPATCH_ENABLE_LOGGING "Enable logging" OFF)
+option(HDIFFPATCH_ENABLE_ATOMIC_U64 "Assume atomic uint64_t support" ON)
+option(HDIFFPATCH_ENABLE_ARM64_LZMA_ASM "Use 7-Zip arm64 optimized LZMA decoder when bundled LZMA is used" OFF)
+option(HDIFFPATCH_USE_CRC_EMU "Force 7-Zip software CRC implementation for VCDIFF/LZMA" OFF)
+option(HDIFFPATCH_MIN_SIZE "Use upstream Makefile MINS size-oriented options" OFF)
+option(HDIFFPATCH_NO_PIE "Pass -no-pie on ELF platforms, matching upstream PIE=-1" OFF)
+option(HDIFFPATCH_STATIC_C_RUNTIME_GNU "Pass -static on GCC/Clang link lines, matching upstream STATIC_C=1" OFF)
+option(HDIFFPATCH_STATIC_CXX_RUNTIME_GNU "Pass -static-libstdc++ on GCC/Clang hdiffz/unit_test, matching upstream STATIC_CPP=1" OFF)
+option(HDIFFPATCH_MSVC_STATIC_RUNTIME "Use /MT and /MTd like the Visual Studio projects" OFF)
+option(HDIFFPATCH_ENABLE_HSYNC_SOURCES "Include libhsync sources in libhdiffpatch like the upstream Makefile archive" ON)
+option(HDIFFPATCH_ENABLE_BZIP2 "Use bzip2" ON)
+option(HDIFFPATCH_ENABLE_LIBDEFLATE "Use libdeflate" OFF) # Default ON Makefile
+option(HDIFFPATCH_ENABLE_ZLIB "Use ZLIB" OFF) # Default ON Makefile
+option(HDIFFPATCH_ENABLE_LZMA "Use LZMA" OFF) # Default ON Makefile
+option(HDIFFPATCH_ENABLE_ZSTD "Use ZSTD" OFF) # Default ON Makefile
+
+if (MSVC AND HDIFFPATCH_MSVC_STATIC_RUNTIME)
+    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+endif ()
+
+if (HDIFFPATCH_ENABLE_BSDIFF AND NOT HDIFFPATCH_ENABLE_BZIP2)
+    message(FATAL_ERROR "Upstream requires bzip2 when BSDIFF support is enabled. Disable HDIFFPATCH_ENABLE_BSDIFF or enable HDIFFPATCH_ENABLE_BZIP2.")
+endif ()
+
+if (HDIFFPATCH_ENABLE_LIBDEFLATE AND NOT HDIFFPATCH_ENABLE_ZLIB)
+    message(WARNING "Upstream warns that libdeflate cannot support every deflate stream without bundled zlib sources.")
+endif ()
+
+function(hdp_resolve_sources out_var)
+    set(_result)
+    foreach (_rel IN LISTS ARGN)
+        set(_base "${_rel}")
+        if (NOT IS_ABSOLUTE "${_base}")
+            set(_base "${HDIFFPATCH_ROOT}/${_base}")
+        endif ()
+
+        set(_found "")
+        foreach (_candidate IN ITEMS
+                "${_base}"
+                "${_base}.c"
+                "${_base}.cpp"
+                "${_base}.cc"
+                "${_base}.cxx"
+                "${_base}.S"
+                "${_base}.asm"
+                "${_base}.ASM")
+            if (EXISTS "${_candidate}")
+                set(_found "${_candidate}")
+                break()
+            endif ()
+        endforeach ()
+
+        if (NOT _found)
+            message(FATAL_ERROR "Required source not found: ${_rel}. Check HDIFFPATCH_ROOT and bundled dependency paths.")
+        endif ()
+        list(APPEND _result "${_found}")
+    endforeach ()
+    set(${out_var} "${_result}" PARENT_SCOPE)
+endfunction()
+
+function(hdp_apply_common_compile_settings target)
+    set_target_properties(${target} PROPERTIES CXX_STANDARD 11 CXX_STANDARD_REQUIRED ON)
+
+    check_ipo_supported(RESULT ipo_supported)
+    if (ipo_supported AND CMAKE_BUILD_TYPE MATCHES "Release|RelWithDebInfo")
+        set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
+    endif ()
+
+    if (MSVC)
+        target_compile_options(${target} PRIVATE /W3 /wd4819)
+    else ()
+        if (HDIFFPATCH_MIN_SIZE)
+            set_property(TARGET ${target} PROPERTY CXX_VISIBILITY_PRESET hidden)
+            set_property(TARGET ${target} PROPERTY VISIBILITY_INLINES_HIDDEN ON)
+            target_compile_options(${target} PRIVATE
+                    -Wno-error=format-security
+                    -ffunction-sections
+                    -fdata-sections
+                    -ffat-lto-objects)
+        endif ()
+    endif ()
+endfunction()
+
+function(hdp_apply_common_link_settings target)
+    if (HDIFFPATCH_NO_PIE)
+        set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE OFF)
+    endif ()
+
+    if (NOT MSVC)
+        if (HDIFFPATCH_MIN_SIZE)
+            target_link_options(${target} PRIVATE -s -Wl,--gc-sections,--as-needed)
+        endif ()
+        if (HDIFFPATCH_STATIC_C_RUNTIME_GNU)
+            target_link_options(${target} PRIVATE -static)
+        endif ()
+    endif ()
+endfunction()
+
+add_library(hdiffpatch_options INTERFACE)
+target_include_directories(hdiffpatch_options
+        INTERFACE
+        $<BUILD_INTERFACE:${HDIFFPATCH_ROOT}>
+        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+)
+target_compile_definitions(hdiffpatch_options INTERFACE
+        _LARGEFILE_SOURCE
+        _FILE_OFFSET_BITS=64
+        _IS_NEED_ALL_CompressPlugin=0
+        _IS_NEED_DEFAULT_CompressPlugin=0
+        _IS_NEED_ALL_ChecksumPlugin=0
+        _IS_NEED_DEFAULT_ChecksumPlugin=0
+        $<$<PLATFORM_ID:Windows>:_IS_USED_WIN32_UTF8_WAPI=1>
+        $<$<PLATFORM_ID:Windows>:_CRT_SECURE_NO_WARNINGS>
+        _IS_OUT_DIFF_INFO=$<IF:$<BOOL:${HDIFFPATCH_ENABLE_DIFF_INFO}>,1,0>
+        _IS_NEED_BSDIFF=$<IF:$<BOOL:${HDIFFPATCH_ENABLE_BSDIFF}>,1,0>
+        _IS_NEED_VCDIFF=$<IF:$<BOOL:${HDIFFPATCH_ENABLE_VCDIFF}>,1,0>
+)
+
+if (NOT HDIFFPATCH_ENABLE_ATOMIC_U64)
+    target_compile_definitions(hdiffpatch_options INTERFACE _IS_NO_ATOMIC_U64=1)
+endif ()
+
+if (HDIFFPATCH_ENABLE_DIR_DIFF)
+    target_compile_definitions(hdiffpatch_options INTERFACE _IS_NEED_DIR_DIFF_PATCH=1 _ChecksumPlugin_fadler64)
+else ()
+    target_compile_definitions(hdiffpatch_options INTERFACE _IS_NEED_DIR_DIFF_PATCH=0)
+endif ()
+
+if (HDIFFPATCH_ENABLE_MULTITHREAD)
+    find_package(Threads REQUIRED)
+    target_compile_definitions(hdiffpatch_options INTERFACE ZSTD_MULTITHREAD=1 _IS_USED_MULTITHREAD=1)
+    target_link_libraries(hdiffpatch_options INTERFACE Threads::Threads)
+else ()
+    target_compile_definitions(hdiffpatch_options INTERFACE Z7_ST _IS_USED_MULTITHREAD=0)
+endif ()
+
+set(HDIFFPATCH_HPATCH_SOURCE_KEYS
+        libHDiffPatch/HPatch/patch
+        libHDiffPatch/HDiff/private_diff/limit_mem_diff/adler_roll
+        file_for_patch)
+
+if (HDIFFPATCH_ENABLE_MULTITHREAD)
+    list(APPEND HDIFFPATCH_HPATCH_SOURCE_KEYS
+            libHDiffPatch/HPatch/hpatch_mt/_hcache_old_mt
+            libHDiffPatch/HPatch/hpatch_mt/_hcache_window_old_mt
+            libHDiffPatch/HPatch/hpatch_mt/_hinput_mt
+            libHDiffPatch/HPatch/hpatch_mt/_houtput_mt
+            libHDiffPatch/HPatch/hpatch_mt/_hpatch_mt
+            libHDiffPatch/HPatch/hpatch_mt/hpatch_mt
+            libParallel/parallel_import_c)
+endif ()
+
+if (HDIFFPATCH_ENABLE_DIR_DIFF)
+    list(APPEND HDIFFPATCH_HPATCH_SOURCE_KEYS
+            dirDiffPatch/dir_patch/dir_patch
+            dirDiffPatch/dir_patch/res_handle_limit
+            dirDiffPatch/dir_patch/ref_stream
+            dirDiffPatch/dir_patch/new_stream
+            dirDiffPatch/dir_patch/dir_patch_tools
+            dirDiffPatch/dir_patch/new_dir_output)
+endif ()
+
+if (HDIFFPATCH_ENABLE_BSDIFF)
+    list(APPEND HDIFFPATCH_HPATCH_SOURCE_KEYS bsdiff_wrapper/bspatch_wrapper)
+endif ()
+
+set(HDIFFPATCH_HDIFF_SOURCE_KEYS
+        hdiffz_import_patch
+        libHDiffPatch/HPatchLite/hpatch_lite
+        libHDiffPatch/HDiff/diff
+        libHDiffPatch/HDiff/private_diff/match_block
+        libHDiffPatch/HDiff/private_diff/bytes_rle
+        libHDiffPatch/HDiff/private_diff/suffix_string
+        libHDiffPatch/HDiff/private_diff/compress_detect
+        libHDiffPatch/HDiff/private_diff/limit_mem_diff/digest_matcher
+        libHDiffPatch/HDiff/private_diff/limit_mem_diff/stream_serialize
+        libHDiffPatch/HDiff/private_diff/libdivsufsort/divsufsort64
+        libHDiffPatch/HDiff/private_diff/libdivsufsort/divsufsort
+        libHDiffPatch/HDiff/private_diff/window_diff/window_matcher
+        libHDiffPatch/HDiff/private_diff/window_diff/covers_range
+        dirDiffPatch/dir_diff/dir_diff_tools)
+
+if (HDIFFPATCH_ENABLE_DIR_DIFF)
+    list(APPEND HDIFFPATCH_HDIFF_SOURCE_KEYS
+            dirDiffPatch/dir_diff/dir_diff
+            dirDiffPatch/dir_diff/dir_manifest)
+endif ()
+
+if (HDIFFPATCH_ENABLE_BSDIFF)
+    list(APPEND HDIFFPATCH_HDIFF_SOURCE_KEYS bsdiff_wrapper/bsdiff_wrapper)
+endif ()
+
+if (HDIFFPATCH_ENABLE_MULTITHREAD)
+    list(APPEND HDIFFPATCH_HDIFF_SOURCE_KEYS
+            libParallel/parallel_channel
+            compress_parallel)
+endif ()
+
+set(HDIFFPATCH_HSYNC_SOURCE_KEYS)
+if (HDIFFPATCH_ENABLE_HSYNC_SOURCES)
+    list(APPEND HDIFFPATCH_HSYNC_SOURCE_KEYS
+            libHDiffPatch/HDiff/private_diff/match_inplace
+            libhsync/sync_client/dir_sync_client
+            libhsync/sync_client/match_in_old
+            libhsync/sync_client/sync_client
+            libhsync/sync_client/sync_diff_data
+            libhsync/sync_client/sync_info_client
+            libhsync/sync_make/dir_sync_make
+            libhsync/sync_make/match_in_new
+            libhsync/sync_make/sync_info_make
+            libhsync/sync_make/sync_make)
+endif ()
+
+if (HDIFFPATCH_ENABLE_BZIP2)
+    target_compile_definitions(hdiffpatch_options INTERFACE _CompressPlugin_bz2)
+    find_package(BZip2 REQUIRED)
+    target_link_libraries(hdiffpatch_options INTERFACE BZip2::BZip2)
+endif ()
+
+if (HDIFFPATCH_ENABLE_ZLIB)
+    target_compile_definitions(hdiffpatch_options INTERFACE _CompressPlugin_zlib)
+    if (HDIFFPATCH_ENABLE_DIR_DIFF)
+        target_compile_definitions(hdiffpatch_options INTERFACE _ChecksumPlugin_crc32)
+    endif ()
+
+    find_package(ZLIB REQUIRED)
+    target_link_libraries(hdiffpatch_options INTERFACE ZLIB::ZLIB)
+endif ()
+
+if (HDIFFPATCH_ENABLE_LIBDEFLATE)
+    target_compile_definitions(hdiffpatch_options INTERFACE
+            _CompressPlugin_ldef
+            _CompressPlugin_ldef_is_use_zlib=$<IF:$<BOOL:${HDIFFPATCH_ENABLE_ZLIB}>,1,0>)
+
+    find_package(libdeflate REQUIRED)
+    target_link_libraries(hdiffpatch_options INTERFACE libdeflate::libdeflate)
+endif ()
+
+if (HDIFFPATCH_ENABLE_DIR_DIFF AND HDIFFPATCH_ENABLE_MD5)
+    target_compile_definitions(hdiffpatch_options INTERFACE _ChecksumPlugin_md5)
+    find_package(LibMD5 REQUIRED)
+    target_link_libraries(hdiffpatch_options INTERFACE LibMD5::LibMD5)
+endif ()
+
+if (HDIFFPATCH_ENABLE_DIR_DIFF AND HDIFFPATCH_ENABLE_XXHASH)
+    target_compile_definitions(hdiffpatch_options INTERFACE _ChecksumPlugin_xxh3 _ChecksumPlugin_xxh128)
+    find_package(xxHash REQUIRED)
+    target_link_libraries(hdiffpatch_options INTERFACE xxHash::xxhash)
+endif ()
+
+if (HDIFFPATCH_ENABLE_LZMA)
+    target_compile_definitions(hdiffpatch_options INTERFACE _CompressPlugin_lzma _CompressPlugin_lzma2)
+    if (HDIFFPATCH_ENABLE_VCDIFF)
+        target_compile_definitions(hdiffpatch_options INTERFACE _CompressPlugin_7zXZ)
+        if (HDIFFPATCH_USE_CRC_EMU)
+            target_compile_definitions(hdiffpatch_options INTERFACE USE_CRC_EMU)
+        endif ()
+    endif ()
+
+    find_package(LibLZMA REQUIRED)
+    target_link_libraries(hdiffpatch_options INTERFACE LibLZMA::LibLZMA)
+endif ()
+
+if (HDIFFPATCH_ENABLE_VCDIFF)
+    list(APPEND HDIFFPATCH_HPATCH_SOURCE_KEYS vcdiff_wrapper/vcpatch_wrapper)
+    list(APPEND HDIFFPATCH_HDIFF_SOURCE_KEYS vcdiff_wrapper/vcdiff_wrapper)
+endif ()
+
+if (HDIFFPATCH_ENABLE_ZSTD)
+    target_compile_definitions(hdiffpatch_options INTERFACE _CompressPlugin_zstd)
+    find_package(zstd REQUIRED)
+    target_link_libraries(hdiffpatch_options INTERFACE zstd::libzstd_static)
+endif ()
+
+hdp_resolve_sources(HDIFFPATCH_HPATCH_SOURCES ${HDIFFPATCH_HPATCH_SOURCE_KEYS})
+hdp_resolve_sources(HDIFFPATCH_HDIFF_SOURCES ${HDIFFPATCH_HDIFF_SOURCE_KEYS})
+if (HDIFFPATCH_HSYNC_SOURCE_KEYS)
+    hdp_resolve_sources(HDIFFPATCH_HSYNC_SOURCES ${HDIFFPATCH_HSYNC_SOURCE_KEYS})
+endif ()
+
+add_library(hpatchz_objects OBJECT ${HDIFFPATCH_HPATCH_SOURCES})
+target_link_libraries(hpatchz_objects PUBLIC hdiffpatch_options)
+hdp_apply_common_compile_settings(hpatchz_objects)
+
+add_library(hdiff_objects OBJECT ${HDIFFPATCH_HDIFF_SOURCES})
+target_link_libraries(hdiff_objects PUBLIC hdiffpatch_options)
+hdp_apply_common_compile_settings(hdiff_objects)
+
+if (HDIFFPATCH_HSYNC_SOURCES)
+    add_library(hsync_objects OBJECT ${HDIFFPATCH_HSYNC_SOURCES})
+    target_link_libraries(hsync_objects PUBLIC hdiffpatch_options)
+    hdp_apply_common_compile_settings(hsync_objects)
+endif ()
+
+set(HDIFFPATCH_ARCHIVE_OBJECTS
+        $<TARGET_OBJECTS:hpatchz_objects>
+        $<TARGET_OBJECTS:hdiff_objects>)
+if (HDIFFPATCH_HSYNC_SOURCES)
+    list(APPEND HDIFFPATCH_ARCHIVE_OBJECTS $<TARGET_OBJECTS:hsync_objects>)
+endif ()
+
+add_library(hdiffpatch STATIC ${HDIFFPATCH_ARCHIVE_OBJECTS})
+target_link_libraries(hdiffpatch PUBLIC hdiffpatch_options)
+hdp_apply_common_compile_settings(hdiffpatch)
+add_library(HDiffPatch::hdiffpatch ALIAS hdiffpatch)
+
+set_target_properties(hdiffpatch PROPERTIES
+        INTERFACE_MSVC_RUNTIME_LIBRARY "${CMAKE_MSVC_RUNTIME_LIBRARY}")
+
+if (HDIFFPATCH_BUILD_TOOLS)
+    hdp_resolve_sources(HDIFFPATCH_HPATCHZ_MAIN "hpatchz")
+    add_executable(hpatchz ${HDIFFPATCH_HPATCHZ_MAIN} $<TARGET_OBJECTS:hpatchz_objects>)
+    target_link_libraries(hpatchz PRIVATE hdiffpatch_options)
+    hdp_apply_common_compile_settings(hpatchz)
+    hdp_apply_common_link_settings(hpatchz)
+
+    hdp_resolve_sources(HDIFFPATCH_HDIFFZ_MAIN "hdiffz")
+    add_executable(hdiffz ${HDIFFPATCH_HDIFFZ_MAIN})
+    target_link_libraries(hdiffz PRIVATE hdiffpatch)
+    hdp_apply_common_compile_settings(hdiffz)
+    hdp_apply_common_link_settings(hdiffz)
+
+    if (NOT MSVC AND HDIFFPATCH_STATIC_CXX_RUNTIME_GNU)
+        target_link_options(hdiffz PRIVATE -static-libstdc++)
+    endif ()
+
+    set(_hdp_manifest "${HDIFFPATCH_ROOT}/builds/vc/longPathAware.exe.manifest")
+    if (MSVC AND EXISTS "${_hdp_manifest}")
+        target_link_options(hpatchz PRIVATE "/MANIFEST:NO" "/MANIFEST:EMBED" "/MANIFESTINPUT:${_hdp_manifest}")
+        target_link_options(hdiffz PRIVATE "/MANIFEST:NO" "/MANIFEST:EMBED" "/MANIFESTINPUT:${_hdp_manifest}")
+    endif ()
+
+    install(TARGETS hpatchz hdiffz RUNTIME DESTINATION bin)
+endif ()
+
+if (HDIFFPATCH_BUILD_TESTS)
+    hdp_resolve_sources(HDIFFPATCH_UNIT_TEST_MAIN "test/unit_test")
+    add_executable(unit_test ${HDIFFPATCH_UNIT_TEST_MAIN})
+    target_link_libraries(unit_test PRIVATE hdiffpatch)
+    hdp_apply_common_compile_settings(unit_test)
+    hdp_apply_common_link_settings(unit_test)
+    if (NOT MSVC AND HDIFFPATCH_STATIC_CXX_RUNTIME_GNU)
+        target_link_options(unit_test PRIVATE -static-libstdc++)
+    endif ()
+    enable_testing()
+    add_test(NAME hdiffpatch_unit_test COMMAND unit_test)
+endif ()
+
+install(TARGETS hdiffpatch ARCHIVE DESTINATION lib LIBRARY DESTINATION lib RUNTIME DESTINATION bin)
+include(cmake/Packaging.cmake)
