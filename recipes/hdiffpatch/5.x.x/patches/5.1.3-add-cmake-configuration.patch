diff --git a/cmake/Findlibdeflate.cmake b/cmake/Findlibdeflate.cmake
new file mode 100644
--- /dev/null	(revision d6d72c146317afe0d532173a41e995b52e1fa743)
+++ b/cmake/Findlibdeflate.cmake	(revision d6d72c146317afe0d532173a41e995b52e1fa743)
@@ -0,0 +1,53 @@
+# Configure sisong's libdeflate fork. There is also a conan recipe in https://conan.io/center/recipes/libdeflate, but
+# sisong made some changes to the original code, so we would have to apply patches if we were to use it. Some of the
+# changes seem to conflict with the main libdeflate repository.
+
+
+include(FetchContent)
+include(GNUInstallDirs)
+
+set(LIBDEFLATE_GIT_REPOSITORY "https://github.com/Seclous/libdeflate.git"
+        CACHE STRING "Git repository for libdeflate")
+set(LIBDEFLATE_GIT_TAG "8f894fab60464e13ddee3846eae722216347fac1"
+        CACHE STRING "Git tag or commit for libdeflate")
+
+message(STATUS "Fetching libdeflate from ${LIBDEFLATE_GIT_REPOSITORY} at ${LIBDEFLATE_GIT_TAG}")
+
+FetchContent_Declare(
+        libdeflate
+        GIT_REPOSITORY ${LIBDEFLATE_GIT_REPOSITORY}
+        GIT_TAG ${LIBDEFLATE_GIT_TAG}
+)
+
+set(LIBDEFLATE_BUILD_STATIC_LIB ON CACHE BOOL "Build the static library" FORCE)
+set(LIBDEFLATE_BUILD_SHARED_LIB OFF CACHE BOOL "Build the shared library" FORCE)
+set(LIBDEFLATE_BUILD_GZIP OFF CACHE BOOL "Build gzip tools" FORCE)
+set(LIBDEFLATE_BUILD_TESTS OFF CACHE BOOL "Build the test programs" FORCE)
+
+FetchContent_MakeAvailable(libdeflate)
+
+if (TARGET libdeflate_static)
+    # Adjust the public header path to point to the correct source
+    set_target_properties(libdeflate_static PROPERTIES
+            PUBLIC_HEADER "${libdeflate_SOURCE_DIR}/libdeflate.h"
+    )
+endif ()
+
+# Normalize to a consistent alias: libdeflate::libdeflate
+# The project may define one of several possible targets.
+# We should always find libdeflate_static, but I leave the other
+# options here for completeness
+if (TARGET libdeflate_static)
+    add_library(libdeflate::libdeflate ALIAS libdeflate_static)
+
+elseif (TARGET libdeflate_shared)
+    add_library(libdeflate::libdeflate ALIAS libdeflate_shared)
+
+elseif (TARGET libdeflate)
+    add_library(libdeflate::libdeflate ALIAS libdeflate)
+
+else ()
+    message(FATAL_ERROR
+            "FetchLibdeflate.cmake: could not find any target (libdeflate_static, libdeflate_shared, or libdeflate). "
+            "The fetched project may have changed its structure.")
+endif ()
