diff --git a/cmake/FindLibLZMA.cmake b/cmake/FindLibLZMA.cmake
new file mode 100644
--- /dev/null	(revision d6d72c146317afe0d532173a41e995b52e1fa743)
+++ b/cmake/FindLibLZMA.cmake	(revision d6d72c146317afe0d532173a41e995b52e1fa743)
@@ -0,0 +1,102 @@
+# Configure sisong's LibLZMA fork. There is a conan recipe in https://conan.io/center/recipes/lzma_sdk, but sisong
+# made some changes to the original code, so we would have to apply patches if we were to use it.
+
+include(FetchContent)
+include(GNUInstallDirs)
+
+set(LZMA_GIT_REPOSITORY "https://github.com/Seclous/lzma.git"
+        CACHE STRING "Git repository for lzma")
+set(LZMA_GIT_TAG "44809544b95bbf2dccec75d954657ff76fc349ff"
+        CACHE STRING "Git tag or commit for lzma")
+
+message(STATUS "Fetching LZMA from ${LZMA_GIT_REPOSITORY} at ${LZMA_GIT_TAG}")
+
+FetchContent_Declare(
+        lzma
+        GIT_REPOSITORY ${LZMA_GIT_REPOSITORY}
+        GIT_TAG ${LZMA_GIT_TAG}
+)
+
+FetchContent_MakeAvailable(lzma)
+
+# Define only once
+if (NOT TARGET LibLZMA::LibLZMA)
+    set(LZMA_C_ROOT "${lzma_SOURCE_DIR}/C")
+
+    # ---- Base sources (always compiled) ----
+    set(LZMA_SOURCES
+            "${LZMA_C_ROOT}/Alloc.c"
+            "${LZMA_C_ROOT}/CpuArch.c"
+            "${LZMA_C_ROOT}/7zStream.c"
+            "${LZMA_C_ROOT}/LzmaDec.c"
+            "${LZMA_C_ROOT}/Lzma2Dec.c"
+            "${LZMA_C_ROOT}/LzFind.c"
+            "${LZMA_C_ROOT}/LzFindOpt.c"
+            "${LZMA_C_ROOT}/LzmaEnc.c"
+            "${LZMA_C_ROOT}/Lzma2Enc.c"
+    )
+
+    # ---- Multithreading sources ----
+    if (DEFINED HDIFFPATCH_ENABLE_MULTITHREAD AND HDIFFPATCH_ENABLE_MULTITHREAD)
+        list(APPEND LZMA_SOURCES
+                "${LZMA_C_ROOT}/MtDec.c"
+                "${LZMA_C_ROOT}/Threads.c"
+                "${LZMA_C_ROOT}/LzFindMt.c"
+                "${LZMA_C_ROOT}/MtCoder.c"
+                "${LZMA_C_ROOT}/Lzma2DecMt.c"
+        )
+    endif ()
+
+    # ---- VCDIFF extras ----
+    if (DEFINED HDIFFPATCH_ENABLE_VCDIFF AND HDIFFPATCH_ENABLE_VCDIFF)
+        list(APPEND LZMA_SOURCES
+                "${LZMA_C_ROOT}/7zCrc.c"
+                "${LZMA_C_ROOT}/7zCrcOpt.c"
+                "${LZMA_C_ROOT}/Bra.c"
+                "${LZMA_C_ROOT}/Bra86.c"
+                "${LZMA_C_ROOT}/BraIA64.c"
+                "${LZMA_C_ROOT}/Delta.c"
+                "${LZMA_C_ROOT}/Sha256.c"
+                "${LZMA_C_ROOT}/Sha256Opt.c"
+                "${LZMA_C_ROOT}/Xz.c"
+                "${LZMA_C_ROOT}/XzCrc64.c"
+                "${LZMA_C_ROOT}/XzCrc64Opt.c"
+                "${LZMA_C_ROOT}/XzDec.c"
+                "${LZMA_C_ROOT}/XzEnc.c"
+        )
+    endif ()
+
+    # ---- Optional ARM64 optimizations ----
+    if (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|ARM64")
+        if (EXISTS "${lzma_SOURCE_DIR}/Asm/arm64/LzmaDecOpt.S")
+            list(APPEND LZMA_SOURCES "${lzma_SOURCE_DIR}/Asm/arm64/LzmaDecOpt.S")
+        endif ()
+    endif ()
+
+    # ---- Create the target ----
+    add_library(LibLZMA STATIC ${LZMA_SOURCES})
+    add_library(LibLZMA::LibLZMA ALIAS LibLZMA)
+
+    target_include_directories(LibLZMA
+            PUBLIC
+            $<BUILD_INTERFACE:${LZMA_C_ROOT}>
+            $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/liblzma>
+    )
+    target_compile_definitions(LibLZMA PRIVATE _FILE_OFFSET_BITS=64)
+
+    if (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|ARM64")
+        target_compile_definitions(LibLZMA PRIVATE Z7_LZMA_DEC_OPT)
+    endif ()
+
+    # Optional: define USE_CRC_EMU only if VCDIFF enabled and requested
+    if (DEFINED HDIFFPATCH_ENABLE_VCDIFF AND HDIFFPATCH_ENABLE_VCDIFF
+            AND DEFINED HDIFFPATCH_USE_CRC_EMU AND HDIFFPATCH_USE_CRC_EMU)
+        target_compile_definitions(LibLZMA PRIVATE USE_CRC_EMU)
+    endif ()
+
+    if (MSVC)
+        set_target_properties(LibLZMA PROPERTIES
+                MSVC_RUNTIME_LIBRARY "${CMAKE_MSVC_RUNTIME_LIBRARY}"
+        )
+    endif ()
+endif ()
