+# Configure sisong's ZLIB fork. There is also a conan recipe in https://conan.io/center/recipes/zlib, but sisong
+# made some changes to the original code, so we would have to apply patches if we were to use it (not too many changes
+# by the author).
+
+include(FetchContent)
+include(GNUInstallDirs)
+
+# Allow override so you can point to a fork or different commit.
+set(ZLIB_GIT_REPOSITORY "https://github.com/Seclous/zlib.git"
+        CACHE STRING "Git repository for zlib")
+set(ZLIB_GIT_TAG "323357a50daba38cedd2b766b3427f4c6d33b10f"
+        CACHE STRING "Git commit or tag for zlib")
+
+message(STATUS "Fetching zlib from ${ZLIB_GIT_REPOSITORY} at ${ZLIB_GIT_TAG}")
+
+FetchContent_Declare(
+        zlib
+        GIT_REPOSITORY ${ZLIB_GIT_REPOSITORY}
+        GIT_TAG ${ZLIB_GIT_TAG}
+)
+
+set(ZLIB_BUILD_TESTING OFF CACHE BOOL "Disable Zlib examples")
+set(ZLIB_BUILD_SHARED OFF CACHE BOOL "Enable building zlib shared library")
+
+FetchContent_MakeAvailable(zlib)
+
+# zlib’s official CMakeLists usually defines ZLIB::ZLIB already.
+# We only add the alias if it is missing.
+if (NOT TARGET ZLIB::ZLIB)
